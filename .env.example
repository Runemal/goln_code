# Имя Compose-проекта. Помогает избежать зависимости от имени каталога.
COMPOSE_PROJECT_NAME=litellm-gateway

# API-ключ NVIDIA с https://build.nvidia.com/.
# Для запуска только с локальными моделями можно оставить заглушку.
NVIDIA_NIM_API_KEY=nvapi-replace-me

# Мастер-ключ LiteLLM. Значение должно начинаться с sk-.
LITELLM_MASTER_KEY=sk-litellm-replace-me

# Используйте URL-безопасные символы: пароль входит в DATABASE_URL.
POSTGRES_PASSWORD=replace-with-a-long-url-safe-password

# Порт на хосте. Измените, если 4001 уже занят.
LITELLM_PORT=4001

# Проверенный образ LiteLLM 1.93.0. Замените digest только после smoke-тестов.
LITELLM_IMAGE=ghcr.io/berriai/litellm-database@sha256:72360d8bd5602faa49be5098a8ac3dd069d9fb74503d6bd014242d96dc753e43

# Локальные серверы моделей на Docker-хосте.
# Префикс провайдера является частью model ID LiteLLM.
OLLAMA_MODEL=ollama_chat/gemma4:latest
OLLAMA_API_BASE=http://host.docker.internal:11434

# Получите ID командой:
# curl -fsS http://127.0.0.1:1234/v1/models | jq -r '.data[].id'
LM_STUDIO_MODEL=openai/replace-with-loaded-model-id
LM_STUDIO_API_BASE=http://host.docker.internal:1234/v1

# При отключённой аутентификации LM Studio оставьте непустую заглушку.
# При включённой аутентификации укажите настоящий API token.
LM_STUDIO_API_KEY=lm-studio

# Стабильные алиасы для профилей Codex и smoke-тестов.
# Полные каталоги дополнительно доступны как ollama/* и lmstudio/*.
# Модели, которые проверяет test-local-models.sh без аргументов.
LOCAL_TEST_MODELS="local/ollama local/lmstudio"
